<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th class="fs-5">Motivo Cessazione</th>
        <th class="fs-5"><i>% sul totale deleghe</i></th>
      </tr>
    </thead>
    <tbody>
      <% StatisticSpi::CessazioniBreakdown::ETICHETTE.each do |etichetta| %>
        <tr>
          <td class="fs-5"><%= etichetta %></td>
          <td class="fs-5">
            <% if row.percentuali[etichetta] %>
              <%= number_to_percentage(row.percentuali[etichetta], precision: 2, locale: :it) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
