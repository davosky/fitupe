<div class="card border-dark p-3 m-2 shadow-sm">
  <h4>
    <span class="p-2 fw-bold fst-italic">
      <%= image_tag("statistic/comprensori.svg", class: "img-fluid me-1", size: "48x48", alt: "comprensori") %>
      Comprensori
      <span class="text-info">&nbsp;Iscritti&nbsp;SPI</span>
    </span>
  </h4>
  <hr class="mt-2 mb-2"/>
  <%= render partial: "comprensori_table", locals: { rows: iscritti_rows, result: result } %>

  <h4 class="mt-4">
    <span class="p-2 fw-bold fst-italic">
      <%= image_tag("statistic/comprensori.svg", class: "img-fluid me-1", size: "48x48", alt: "comprensori") %>
      Comprensori
      <span class="text-info">&nbsp;Deleghe&nbsp;SPI</span>
    </span>
  </h4>
  <hr class="mt-2 mb-2"/>
  <%= render partial: "comprensori_table", locals: { rows: deleghe_rows, result: result } %>

  <%= render partial: "comparison_chart", locals: {
    labels: iscritti_rows.map { |c| c.zoning.descrizione_azzonamento },
    iscritti_previous_data: iscritti_rows.map(&:count_precedente),
    iscritti_current_data: iscritti_rows.map(&:count_anno),
    deleghe_previous_data: deleghe_rows.map(&:count_precedente),
    deleghe_current_data: deleghe_rows.map(&:count_anno),
    iscritti_percentages: iscritti_rows.map(&:diff_percent),
    deleghe_percentages: deleghe_rows.map(&:diff_percent),
    result: result
  } %>
</div>
