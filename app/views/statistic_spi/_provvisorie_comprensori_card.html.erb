<div class="card border-dark p-3 m-2 shadow-sm">
  <h4>
    <span class="p-2 fw-bold fst-italic">
      <%= image_tag("statistic/comprensori.svg", class: "img-fluid me-1", size: "48x48", alt: "comprensori") %>
      Comprensori
      <br/>
      <span class="text-danger">
        &nbsp;
        <%= image_tag("statistic/provvisorie.svg", class: "img-fluid me-1", size: "48x48", alt: "provvisorie") %>
        &nbsp;
        Provvisorie
        <%= image_tag("statistic/logospi.svg", class: "img-fluid ms-1", size: "40x40", alt: "logospi") %>
      </span>
    </span>
  </h4>
  <hr class="mt-2 mb-2"/>
  <%= render partial: "provvisorie_table", locals: { rows: rows } %>
  <% deleghe_confermate_percentuale = 100.0 - (total_row.percentuale || 0) %>
  <div class="mx-auto mt-4" style="position: relative; height: 420px; width: 75%;"
      data-controller="pie-chart"
      data-pie-chart-labels-value="<%= (rows.map { |row| row.zoning.descrizione_azzonamento } + [ 'Deleghe Confermate' ]).to_json %>"
      data-pie-chart-data-value="<%= (rows.map { |row| row.percentuale || 0 } + [ deleghe_confermate_percentuale ]).to_json %>"
      data-pie-chart-raw-percentages-value="true">
    <canvas data-pie-chart-target="canvas"></canvas>
  </div>
</div>
