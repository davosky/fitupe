<div class="card border-dark p-3 m-2 shadow-sm">
  <h4>
    <span class="p-2 fw-bold fst-italic">
      <%= image_tag("statistic/regionale.svg", class: "img-fluid me-1", size: "48x48", alt: "regionale") %>
      <%= row.zoning.descrizione_azzonamento %>
      <br/>
      <span class="text-danger">
        &nbsp;
        <%= image_tag("statistic/multiplespi.svg", class: "img-fluid me-1", size: "48x48", alt: "deleghe multiple") %>
        &nbsp;
        Deleghe
        &nbsp;
        Multiple
        &nbsp;
        <%= image_tag("statistic/logospi.svg", class: "img-fluid ms-1", size: "40x40", alt: "logospi") %>
      </span>
    </span>
  </h4>
  <hr class="mt-2 mb-2"/>
  <%= render partial: "multiple_delegations_table", locals: { rows: [ row ] } %>
</div>
