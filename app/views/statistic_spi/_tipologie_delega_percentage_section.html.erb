<% if heading %>
  <h5 class="mt-4">
    <span class="text-secondary p-2 fw-bold fst-italic"><%= heading %></span>
  </h5>
<% end %>
<div class="row align-items-center <%= "mt-4" unless heading %>">
  <div class="col-md-8">
    <div class="mx-auto" style="position: relative; height: 320px; width: 100%; max-width: 700px;"
        data-controller="bar-chart"
        data-bar-chart-labels-value="<%= StatisticSpi::TipologieDelegaBreakdown::ETICHETTE.to_json %>"
        data-bar-chart-data-value="<%= StatisticSpi::TipologieDelegaBreakdown::ETICHETTE.map { |etichetta| row.totali[etichetta] }.to_json %>"
        data-bar-chart-percentages-value="<%= StatisticSpi::TipologieDelegaBreakdown::ETICHETTE.map { |etichetta| row.percentuali[etichetta] || 0 }.to_json %>">
      <canvas data-bar-chart-target="canvas"></canvas>
    </div>
  </div>
  <div class="col-md-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th class="fs-5">Tipologia Delega</th>
            <th class="fs-5"><i>% sul totale deleghe</i></th>
          </tr>
        </thead>
        <tbody>
          <% StatisticSpi::TipologieDelegaBreakdown::ETICHETTE.each do |etichetta| %>
            <tr>
              <td class="fs-5"><%= etichetta %></td>
              <td class="fs-5">
                <% if row.percentuali[etichetta] %>
                  <%= number_to_percentage(row.percentuali[etichetta], precision: 2, locale: :it) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
