<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th class="fs-5">Azzonamento</th>
        <th class="fs-5"><i>Doppia</i></th>
        <th class="fs-5"><i>Tripla</i></th>
        <th class="fs-5"><i>Quadrupla</i></th>
        <th class="fs-5"><i>Quintupla</i></th>
        <th class="fs-5"><i>totale deleghe multiple</i></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <td class="fs-5"><%= row.zoning.descrizione_azzonamento %></td>
          <td class="fs-5 fw-bold"><%= number_with_delimiter(row.doppia, locale: :it) %></td>
          <td class="fs-5 fw-bold"><%= number_with_delimiter(row.tripla, locale: :it) %></td>
          <td class="fs-5 fw-bold"><%= number_with_delimiter(row.quadrupla, locale: :it) %></td>
          <td class="fs-5 fw-bold"><%= number_with_delimiter(row.quintupla, locale: :it) %></td>
          <td class="fs-5 fw-bold"><%= number_with_delimiter(row.totale, locale: :it) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
