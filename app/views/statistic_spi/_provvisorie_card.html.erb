<div class="card border-dark p-3 m-2 shadow-sm">
  <h4>
    <span class="p-2 fw-bold fst-italic">
      <%= image_tag("statistic/regionale.svg", class: "img-fluid me-1", size: "48x48", alt: "regionale") %>
      <%= row.zoning.descrizione_azzonamento %>
      <br/>
      <span class="text-danger">
        &nbsp;
        <%= image_tag("statistic/provvisorie.svg", class: "img-fluid me-1", size: "48x48", alt: "provvisorie") %>
        &nbsp;
        Provvisorie
        &nbsp;
        <%= image_tag("statistic/logospi.svg", class: "img-fluid ms-1", size: "40x40", alt: "logospi") %>
      </span>
    </span>
  </h4>
  <hr class="mt-2 mb-2"/>
  <%= render partial: "provvisorie_table", locals: { rows: [ row ] } %>
  <% deleghe_confermate = row.deleghe_totale - row.totale %>
  <div class="mx-auto mt-4" style="position: relative; height: 420px; width: 75%;"
      data-controller="pie-chart"
      data-pie-chart-labels-value="<%= [ 'Provvisorie', 'Deleghe Confermate' ].to_json %>"
      data-pie-chart-data-value="<%= [ row.totale, deleghe_confermate ].to_json %>">
    <canvas data-pie-chart-target="canvas"></canvas>
  </div>
</div>
