<% content_for :title, "Importazione SPI in corso" %>
<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
  <h3 class="text-primary">
    <i class="fw-bold">
      <i class="bi bi-upload me-1"></i>
      <i class="bi bi-person me-2"></i>
      Importazione SPI in corso
    </i>
  </h3>
  <%= link_to "Torna all'elenco", import_spis_path, class: "btn btn-outline-secondary" %>
</div>
<hr class="text-primary mb-5"/>
<%= turbo_stream_from "import_spi_progress_#{@token}" %>
<%= render "progress", **@progress %>
