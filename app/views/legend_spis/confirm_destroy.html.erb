<% content_for :title, "Elimina legenda SPI" %>
<div class="mt-5 mb-3">
  <h3 class="text-danger">
    <i class="fw-bold">
      <%= image_tag("legend/legendaspi-logo-destroy.svg", class: "img-fluid me-3", size: "58x58", alt: "Legenda SPI") %>
      Elimina Legenda SPI
    </i>
  </h3>
</div>
<hr class="text-danger m-3"/>
<div class="row">
  <div class="col-6 offset-3">
    <div class="card border-danger shadow">
      <div class="card-body p-4">
        <h4 class="text-danger">
          Sei sicuro di voler eliminare la legenda SPI:
        </h4>
        <h4 class="text-danger">
          <strong><%= @legend_spi.zoning.descrizione_azzonamento %> - <%= @legend_spi.month %>/<%= @legend_spi.year %></strong>?
        </h4>
        <hr class="text-danger"/>
        <div class="d-flex mt-3">
          <%= link_to legend_spis_path, class: "btn btn-dark shadow me-3" do %>
            <i class="bi bi-arrow-counterclockwise me-2"></i>
            Annulla
          <% end %>
          <%= button_to legend_spi_path(@legend_spi), method: :delete, class: "btn btn-danger shadow" do %>
            <i class="bi bi-trash-fill me-2"></i>
            Elimina definitivamente
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
